# Copy to deploy/.env and fill in. Consumed by docker-compose.yml + backend.
# ----------------------------------------------------------------------------

# Public hostname (must resolve to this box; Caddy gets TLS for it).
SITE_HOST=gateway.imagineering.cc
PUBLIC_URL=https://gateway.imagineering.cc

# --- Blockchain: local Hardhat on the box ----------------------------------
# Backend signs mints with this key; setup-minter.js registers its address
# (Hardhat account #0) as the authorised minter. Throwaway chain → safe to commit.
MINTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Watermark engine -------------------------------------------------------
# Shared between the engine (its API_KEY) and the backend (its WATERMARK_API_KEY).
WATERMARK_API_KEY=change-me-watermark-key
# Override if you tag the engine image differently than watermark-engine:local
# WATERMARK_IMAGE=watermark-engine:local

# --- Encryption (KMS off → dev key) ----------------------------------------
USE_KMS=false
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEV_ENCRYPTION_KEY=

# --- Data layer: per-service (mock by default; flip to real as needed) ------
# IPFS / Pinata — set USE_MOCK_IPFS=false and add PINATA_JWT to use real Pinata.
USE_MOCK_IPFS=true
# PINATA_JWT=

# Arweave (NFT metadata) — set false + provide wallet JSON to use real Arweave.
USE_MOCK_ARWEAVE=true
# ARWEAVE_WALLET_JSON=

# Firestore (token/user metadata) — false + Firebase creds to use real Firestore.
USE_MOCK_FIRESTORE=true
USE_MOCK_STORAGE=true
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase.json

# AI generation (Stability) — false + key to enable real generation.
USE_MOCK_AI=true
# STABILITY_API_KEY=

# --- App config -------------------------------------------------------------
ALLOWED_ORIGINS=https://gateway.imagineering.cc
SIWE_DOMAIN=gateway.imagineering.cc
ADMIN_WALLETS=
