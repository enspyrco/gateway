rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Token metadata cache — public read, backend-only write (via Admin SDK)
    match /tokens/{tokenId} {
      allow read: if true;
      allow write: if false;
    }

    // AI generation records — owner read, backend-only write
    match /generations/{generationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User profiles — owner read/write
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny — all other collections are backend-only (Admin SDK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
